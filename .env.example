# Close CRM API key.
#
# Server-side only — this is read exclusively by api/close/[...path].ts and is
# never exposed to the browser. Do NOT prefix it with VITE_, which would inline
# it into the client bundle and publish your key.
#
# Get one from Close: Settings → Developer → API Keys.
# Leave this unset and the app runs entirely in demo mode against fixtures.
CLOSE_API_KEY=
